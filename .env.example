# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-your-token-here

# Провайдер курсов валют: demo (без сети) или exchangerate (реальный API)
RATE_PROVIDER=demo

# Администраторы (id через запятую) и чат, куда падают уведомления
ADMIN_IDS=111111111,222222222
MANAGER_CHAT_ID=

# База данных
DB_URL=sqlite+aiosqlite:///data/bot.db

# Режим работы и правила записи
WORK_START=10:00
WORK_END=20:00
SLOT_STEP_MIN=30
BOOKING_DAYS_AHEAD=7
CANCEL_DEADLINE_HOURS=3

# Антифлуд: пауза между действиями одного пользователя, секунды
THROTTLE_SECONDS=0.7
